# FitTrack Pro - Global Environment Configuration

# Server Settings
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/fittrack_pro

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_fittrack_pro_production_grade_random_2026
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials (Change immediately upon first login)
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL=admin@fittrack.com
INITIAL_ADMIN_PASSWORD=your_secure_initial_admin_password_here
INITIAL_ADMIN_PHONE="+923001234567"

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# Gym Payment Instruction Settings
BANK_NAME="Standard Gym Bank"
BANK_ACCOUNT_TITLE="FitTrack Pro Fitness Club"
BANK_ACCOUNT_NUMBER="12345678901234"
BANK_IBAN="PK36SCBL0000001123456701"
JAZZCASH_NUMBER="03001234567"
JAZZCASH_TITLE="FitTrack Club"
EASYPAISA_NUMBER="03121234567"
EASYPAISA_TITLE="FitTrack Club"

